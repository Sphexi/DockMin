      "networks": {
        "default": null
      }
    },
    "e": {
      "command": null,
      "entrypoint": null,
      "healthcheck": {
        "interval": "0s",
        "test": [
          "CMD-SHELL",
          "x"
        ]
      },
      "image": "registry:2",
