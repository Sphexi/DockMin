{
  "configs": {
    "c1": {
      "content": "hello",
      "name": "shop_c1"
    },
    "c2": {
      "environment": "CFGVAR",
      "name": "shop_c2"
    },
    "c3": {
      "file": "/srv/stack-work/c3.txt",
      "name": "shop_c3"
    },
    "c4": {
      "content": "line1\nline2\n",
      "labels": {
        "cl": "cv"
      },
      "name": "shop_c4"
    },
    "extcfg": {
      "external": true,
      "name": "extcfg"
    }
  },
  "name": "shop",
  "networks": {
    "default": {
      "ipam": {},
      "name": "shop_default"
    }
  },
  "secrets": {
    "exts": {
      "external": true,
      "name": "ext-explicit"
    },
    "s1": {
      "environment": "SECVAR",
      "name": "shop_s1"
    },
    "s2": {
      "file": "/srv/stack-work/s2.txt",
      "name": "shop_s2"
    }
  },
  "services": {
    "web": {
      "command": null,
      "configs": [
        {
          "source": "c1"
        },
        {
          "gid": "1001",
          "mode": "0440",
          "source": "c2",
          "target": "/etc/c2.conf",
          "uid": "1000"
        },
        {
          "mode": "0400",
          "source": "c3"
        },
        {
          "mode": "0644",
          "source": "c4",
          "target": "rel/c4"
        },
        {
          "source": "extcfg"
        }
      ],
      "entrypoint": null,
      "image": "registry:2",
      "networks": {
        "default": null
      },
      "secrets": [
        {
          "source": "s1",
          "target": "/run/secrets/s1"
        },
        {
          "gid": "6",
          "mode": "0400",
          "source": "s2",
          "target": "mysecret",
          "uid": "5"
        },
        {
          "source": "exts",
          "target": "/run/secrets/exts"
        }
      ]
    }
  }
}
