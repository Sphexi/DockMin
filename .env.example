# Copy to .env. The encryption key is not set here.

# Image to run. Build it locally with: docker build -t dockmin:local .
DOCKMIN_IMAGE=dockmin:local

# Host port published on 127.0.0.1, and the port the plain HTTP listener uses.
DOCKMIN_PORT=8000

# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
DOCKMIN_LOG_LEVEL=INFO

# Numeric group id owning /var/run/docker.sock on the Docker host.
# Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=999

# Session lifetime. A bare number is seconds; ISO 8601 durations such as PT12H also work.
DOCKMIN_SESSION_LIFETIME=43200

# Secure attribute and __Host- prefix on the session and CSRF cookies. Set false only for plain HTTP.
DOCKMIN_COOKIE_SECURE=true

# Milliseconds a statement waits for a write lock before failing.
DOCKMIN_DB_BUSY_TIMEOUT_MS=5000

# Seconds between status and object-count refreshes for each environment, 15 to 3600.
DOCKMIN_SNAPSHOT_INTERVAL_SECONDS=60

# Days of activity history kept, 7 to 3650. Unset keeps every event. Events not yet exported, or still read by automation, are kept longer.
DOCKMIN_ACTIVITY_RETENTION_DAYS=

# Requests and WebSocket sessions in flight across both listeners, 8 to 4096. Excess requests get 503.
DOCKMIN_MAX_CONCURRENT_REQUESTS=256

# Comma-separated loopback, link-local or unspecified addresses or networks that endpoints may use, such as 127.0.0.1/32.
# Each entry lets administrators reach that address from the server, including a metadata service on 169.254.169.254. Leave empty unless an endpoint needs it.
DOCKMIN_PERMITTED_INTERNAL_NETWORKS=

# Reverse proxy address or network, comma separated. Unset, every client is seen as the proxy, and per-address login lockout stays off unless the server terminates TLS itself.
DOCKMIN_TRUSTED_PROXIES=

# Public origins behind a reverse proxy that rewrites Host, comma separated, such as https://dockmin.example.com.
DOCKMIN_TRUSTED_ORIGINS=

# Reverse-proxy example (examples/reverse-proxy/nginx). The address must lie inside the subnet and outside the range.
# DOCKMIN_PROXY_SUBNET=172.29.250.0/24
# DOCKMIN_PROXY_IP_RANGE=172.29.250.128/25
# DOCKMIN_PROXY_ADDRESS=172.29.250.2
# DOCKMIN_PROXY_TLS_CERT_SOURCE=./secrets/proxy_fullchain.pem
# DOCKMIN_PROXY_TLS_KEY_SOURCE=./secrets/proxy_privkey.pem

# Direct HTTPS example (examples/direct-https). DOCKMIN_HTTP_MODE is serve, redirect or off.
# DOCKMIN_TLS_CERT_SOURCE=./secrets/tls_fullchain.pem
# DOCKMIN_TLS_KEY_SOURCE=./secrets/tls_privkey.pem
# DOCKMIN_HTTPS_PORT=8443
# DOCKMIN_HTTPS_PUBLIC_PORT=443
# DOCKMIN_HTTP_MODE=redirect

# Encryption key: ./secrets/dockmin_secret_key, mounted as a Docker secret. Base64 of 32 random bytes; surrounding whitespace is ignored.
#   install -d -m 0700 secrets && (umask 077 && openssl rand -base64 32 | tr -d '\r\n' > secrets/dockmin_secret_key)
# Then, as root, give the file to the container user (uid 10001):
#   chown 10001:10001 secrets/dockmin_secret_key && chmod 0400 secrets/dockmin_secret_key
# Never put the key in this file or in DOCKMIN_SECRET_KEY; the environment is visible in `docker inspect`.
